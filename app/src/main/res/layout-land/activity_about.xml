<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".AboutActivity"
    android:background="@drawable/bgf"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvAbout1"
        android:textStyle="bold"
        android:textSize="32dp"
        android:textColor="#000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Мене звати Малік, мій БІП : Ільгарович Малік Багіров . Я народився  11.03.2016"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAbout2"
        android:textSize="32dp"
        android:textColor="#FF0000"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Мої досягненя : Я получив грамоту зі Scratch , Java . І ще робив багото проектів на цих платформах . Також знаю мову програмування JavaFX"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAbout1" />
</androidx.constraintlayout.widget.ConstraintLayout>